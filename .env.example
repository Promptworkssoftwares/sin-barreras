# ==============================
# Sin Barreras SaaS v1.4.44
# ==============================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=Sin Barreras
SESSION_SECRET=

# MongoDB Atlas - coloca la URI real solamente en tu .env local o en las variables seguras del hosting.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/?retryWrites=true&w=majority&appName=SinBarreras
MONGODB_DB_NAME=sin_barreras

# DNS resiliente para MongoDB SRV.
# En modo automatico la app usa el DNS normal si funciona y cambia SOLO dentro
# del proceso Node.js a Cloudflare/Google si una red, VPN o hotspot deja un
# resolver local roto (por ejemplo 127.0.0.1). No modifica el DNS de Windows.
MONGODB_DNS_FALLBACK=true
MONGODB_DNS_SERVERS=8.8.8.8,1.1.1.1

# Owner
OWNER_EMAIL=TU_EMAIL
OWNER_PASSWORD=TU_PASSWORD_OWNER

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional: Sign in with ChatGPT
CHATGPT_OAUTH_ENABLED=false
CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_CLIENT_SECRET=
CHATGPT_OAUTH_AUTHORIZATION_URL=
CHATGPT_OAUTH_TOKEN_URL=
CHATGPT_OAUTH_USERINFO_URL=
CHATGPT_OAUTH_CALLBACK_URL=http://localhost:3000/auth/chatgpt/callback

# Stripe subscription: $5.99 USD / month
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_MONTHLY_AMOUNT=599

# OpenAI
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSLATION_MODEL=gpt-5-nano
COACH_MODEL=
VISION_MODEL=gpt-5-nano
TTS_MODEL=gpt-4o-mini-tts
OPENAI_TIMEOUT_MS=45000
AI_RATE_LIMIT=60

ALLOWED_ORIGINS=http://localhost:3000

# Google Play Billing (Android AAB)
GOOGLE_PLAY_PACKAGE_NAME=com.promptworks.sinbarreras
GOOGLE_PLAY_PRODUCT_ID=sin_barreras_monthly
GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL=
# Keep the private key in Render/hosting secrets. Newlines may be stored as \\n.
GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY=
