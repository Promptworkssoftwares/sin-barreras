# ==============================
# Sin Barreras SaaS v1.4.16
# ==============================
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
APP_NAME=Sin Barreras
SESSION_SECRET=

# MongoDB Atlas - coloca la URI real solamente en tu .env local o en las variables seguras del hosting.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster_host>/?retryWrites=true&w=majority&appName=SinBarreras
MONGODB_DB_NAME=sin_barreras

# Owner
OWNER_EMAIL=TU_EMAIL
OWNER_PASSWORD=TU_PASSWORD_OWNER

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Optional: Sign in with ChatGPT
CHATGPT_OAUTH_ENABLED=false
CHATGPT_OAUTH_CLIENT_ID=
CHATGPT_OAUTH_CLIENT_SECRET=
CHATGPT_OAUTH_AUTHORIZATION_URL=
CHATGPT_OAUTH_TOKEN_URL=
CHATGPT_OAUTH_USERINFO_URL=
CHATGPT_OAUTH_CALLBACK_URL=http://localhost:3000/auth/chatgpt/callback

# Stripe subscription: $5.99 USD / month
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
STRIPE_MONTHLY_AMOUNT=599

# OpenAI
OPENAI_API_KEY=
TRANSCRIPTION_MODEL=whisper-1
TRANSLATION_MODEL=gpt-5-nano
COACH_MODEL=
VISION_MODEL=gpt-5-nano
TTS_MODEL=gpt-4o-mini-tts
OPENAI_TIMEOUT_MS=45000
AI_RATE_LIMIT=60

ALLOWED_ORIGINS=http://localhost:3000
